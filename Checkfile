# -trimpath and -buildvcs=false keep a test binary a function of its
# source alone, so a result cached by one runner slot counts for
# another. -short skips TestBrowse: a runner would download the
# headless shell on every cold cache and may lack its shared
# libraries. A laptop runs the suite without -short.
test: go test -short -trimpath -buildvcs=false -race -cover ./...

# goimports -l lists what it would rewrite, and a non-empty list is
# the failure, since a CI job that rewrote source would have nowhere
# to put it.
# go tool, from the tool lines in go.mod: the runner fetches only the
# modules go.mod names, and runs each check with GOPROXY=off.
lint: out=$(go tool goimports -local "$(go list -m)" -l .); if [ -n "$out" ]; then echo "$out"; exit 1; fi; go vet ./...

# gopls at hint severity is what an editor underlines and nobody
# reading a diff sees. It exits 0 either way, so awk reads the verdict.
hints: git ls-files -z '*.go' | xargs -0 gopls check -severity=hint | awk '1; END { exit (NR > 0) }'

# deadcode -test roots at the test binaries as well as main, so a
# helper only a skipped test reaches still counts as reached.
# go tool -n builds deadcode and prints only its path, so a line from
# the build does not count as dead code.
deadcode: go tool -n deadcode >/dev/null && go tool deadcode -test ./... 2>&1 | awk '1; END { exit (NR > 0) }'

# dprint wraps Markdown at 72, the same column the commits use.
fmt: dprint check

# scripts/tag, which nobody compiles. It pushes a tag to GitHub, and a
# mistake there publishes a version a consumer cannot fetch, or none at
# all. The file carries no extension, so name the directory as a path.
shellcheck: git ls-files -z '*.sh' 'scripts/*' | xargs -0 shellcheck

# A tool line in go.mod pins govulncheck. It reads the live
# vulnerability database, so a new advisory fails this check without a
# commit.
weekly_govulncheck: go tool govulncheck ./...

# The title a change needs to merge, and the body rules that come
# with it. sockeye reads this from main at merge.
merge: ^[a-z][a-z0-9_/-]*(?:, ?[a-z][a-z0-9_/-]*)*: [a-z](?:.{2,62})?(?:[^.\s]|\.\.\.)$
